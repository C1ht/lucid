{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lucid",
  "version": "0.1.0",
  "identifier": "com.lucid.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "theme": "Dark",
        "backgroundColor": "#000000",
        "title": "Lucid",
        "width": 1100,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/lucid-backend"],
    "resources": {
      "binaries/rip.exe": "binaries/rip.exe",
      "binaries/ffmpeg.exe": "binaries/ffmpeg.exe",
      "../../frontend": "frontend"
    }
  }
}
