{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:8799/*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "opener:default",
    "dialog:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "lucid-backend", "sidecar": true }]
    },
    "shell:allow-kill"
  ]
}
